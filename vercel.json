{
  "version": 2,
  "builds": [
    { "src": "*.php", "use": "vercel-php@0.7.2" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "data/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)", "dest": "/js/$1" },
    { "src": "/data/(.*)", "dest": "/data/$1" },
    { "src": "/api", "dest": "/api.php" },
    { "src": "/api(.*)", "dest": "/api.php" },
    { "src": "/(.*)\\.php", "dest": "/$1.php" },
    { "src": "/", "dest": "/index.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
